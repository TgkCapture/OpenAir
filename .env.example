# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=openair
DB_PASSWORD=changeme
DB_NAME=openair_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_PRIVATE_KEY_PATH=./config/keys/private.pem
JWT_PUBLIC_KEY_PATH=./config/keys/public.pem

# Storage
S3_BUCKET=openair-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Streaming
RTMP_SECRET=changeme
HLS_BASE_URL=http://localhost:8080/hls

# FCM
FCM_SERVER_KEY=

# Payments
AIRTEL_API_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
MPAMBA_API_URL=
MPAMBA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
APP_PORT=8000
# Address clients use to reach this server, used in uploaded media URLs.
# Leave empty in development to use the address each request arrives on.
PUBLIC_BASE_URL=
# Browser origins allowed to call the API, comma-separated, for example the
# admin dashboard: https://admin.example.com. Empty allows any origin in
# development and none elsewhere.
CORS_ALLOWED_ORIGINS=
# Largest upload accepted, in megabytes.
UPLOAD_MAX_MB=2048
APP_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=